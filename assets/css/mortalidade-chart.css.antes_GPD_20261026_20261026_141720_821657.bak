/* Nova modificação de 26/10/2026: somente Detalhamento de mortalidade. */
.mortality-evolution{--mortality-band-0:#1E3A8A;--mortality-band-1:#2563EB;--mortality-band-2:#0EA5E9;--mortality-band-3:#14B8A6;--mortality-band-4:#84CC16;--mortality-band-5:#F59E0B;--mortality-total-label:#c95b65}
[data-theme="dark"] .mortality-evolution{--mortality-total-label:#ff9299}
.mortality-evolution .card-heading-row{flex-wrap:wrap;gap:14px}
.mortality-evolution .mortality-chart-scroll{overflow-x:auto;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
.mortality-evolution #evolucaoChart{height:470px;min-width:100%}
.mortality-legend{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 18px;margin:14px 0 4px;font-size:12px;color:var(--foreground)}
.mortality-legend span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.mortality-legend i{display:inline-block;width:12px;height:12px;border-radius:2px}
.mortality-legend .mortality-line-key{width:20px;height:3px}
.mortality-audit-scroll{overflow:auto}.mortality-audit-scroll table{border-collapse:collapse;font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}
.mortality-audit-scroll th,.mortality-audit-scroll td{padding:10px;border:1px solid var(--border);text-align:right}.mortality-audit-scroll th:first-child{text-align:left}
#mortalityAudit>p{color:var(--foreground);padding:12px 0}
@media(max-width:600px){.mortality-evolution #evolucaoChart{height:410px}.mortality-evolution .history-view-filter{margin-left:auto}}
