:root{--phase-0:#641b36;--phase-1:#8c2d47;--phase-2:#b34c53;--phase-3:#cc7358;--phase-4:#bb843a;--phase-5:#8c8722}
[data-theme="dark"]{--phase-0:#d6729c;--phase-1:#e78eaa;--phase-2:#f3a393;--phase-3:#f2b87e;--phase-4:#e7cb70;--phase-5:#c8d27d}
.phase-card{padding:20px;min-width:0}.phase-heading,.phase-actions{display:flex;align-items:center;justify-content:space-between;gap:12px}.phase-heading p,.phase-note{color:var(--muted-foreground);font-size:12px;margin:6px 0}.phase-unit{font-size:12px;color:var(--muted-foreground);font-weight:500}.phase-chart{height:430px;margin-top:16px;width:100%}.phase-table-wrap{overflow:auto;max-height:420px;margin-top:16px;border:1px solid var(--border);border-radius:10px}.phase-table{border-collapse:separate;border-spacing:0;min-width:100%;font-size:12px;font-variant-numeric:tabular-nums}.phase-table th,.phase-table td{padding:13px 15px;border-bottom:1px solid var(--border);white-space:nowrap;text-align:right}.phase-table th{background:var(--card);font-weight:600}.phase-table thead th{position:sticky;top:0;z-index:2}.phase-table th:first-child{position:sticky;left:0;text-align:left;z-index:1;min-width:145px}.phase-table thead th:first-child{z-index:3}.phase-table td:last-child{font-weight:700;background:var(--muted)}.phase-swatch{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px}.phase-table td small{display:block;font-size:10px;color:var(--muted-foreground);margin-top:3px;font-weight:400}.phase-chart:empty:before{content:'Consultando…';display:grid;place-items:center;height:100%;color:var(--muted-foreground)}@media(max-width:600px){.phase-card{padding:14px}.phase-heading{align-items:flex-start;flex-wrap:wrap}.phase-actions{margin-left:auto}.phase-chart{height:360px}.phase-table th,.phase-table td{padding:11px}}

.phase-heading h2{font-size:17px;line-height:1.3;margin:0}.phase-heading .phase-unit{font-size:12px}
